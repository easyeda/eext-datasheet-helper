{
	"name": "pro-api-sdk",
	"version": "1.3.2",
	"description": "嘉立创EDA & EasyEDA 专业版扩展 API 开发工具",
	"author": "JLCEDA <support@lceda.cn>",
	"license": "Apache-2.0",
	"homepage": "https://pro.lceda.cn/",
	"engines": {
		"node": ">=20.17.0"
	},
	"scripts": {
		"compile": "npm run compile:iframe && rimraf ./dist/ && ts-node ./config/esbuild.prod.ts",
		"lint": "eslint",
		"fix": "eslint --fix",
		"build": "npm run compile && ts-node ./build/packaged.ts",
		"compile:iframe": "ts-node ./iframe/build.ts",
		"typecheck": "tsc -p tsconfig.local.json",
		"test": "node --test tests/unit.test.mjs",
		"test:browser": "npm run compile:iframe && node tests/browser.mjs",
		"test:models": "npm run compile:iframe && node tests/model-smoke.mjs"
	},
	"dependencies": {
		"@huggingface/transformers": "4.0.1",
		"@tesseract.js-data/chi_sim": "1.0.0",
		"@tesseract.js-data/eng": "1.0.0",
		"pdfjs-dist": "3.11.174",
		"tesseract.js": "5.1.0",
		"transformers-vlm": "npm:@huggingface/transformers@3.7.5"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^5.4.1",
		"@jlceda/pro-api-types": "^0.3.4",
		"@types/fs-extra": "^11.0.4",
		"esbuild": "^0.24.2",
		"eslint": "^9.37.0",
		"fs-extra": "^11.3.0",
		"ignore": "^7.0.3",
		"jszip": "^3.10.1",
		"lint-staged": "^16.2.3",
		"pdf-lib": "1.17.1",
		"playwright": "1.63.0",
		"prettier": "3.9.6",
		"rimraf": "^6.0.1",
		"simple-git-hooks": "^2.13.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.7.3"
	},
	"simple-git-hooks": {
		"pre-commit": "npx lint-staged"
	},
	"lint-staged": {
		"*": "eslint --fix"
	}
}
